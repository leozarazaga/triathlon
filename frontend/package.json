{
  "name": "react-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "json-server --watch data/db.json --port 3000",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:0-lint": "eslint .",
    "check:1-tsc": "tsc --noEmit --project tsconfig.app.json",
    "check:2-type-coverage": "type-coverage --at-least 100 --detail --project tsconfig.app.json",
    "check": "run-s check:*"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bootstrap": "^5.3.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sass": "^1.99.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bootstrap": "^5.2.10",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "json-server": "^1.0.0-beta.15",
    "npm-run-all2": "^8.0.4",
    "type-coverage": "^2.29.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}